# Copy to .env for local development.

# --- Database -------------------------------------------------------
# Local dev: a plain local Postgres. SSL is auto-disabled for
# localhost/127.0.0.1 (see src/db.js).
DATABASE_URL=postgresql://postgres:password@localhost:5432/slm_dev

# Production (Supabase): use a POOLER connection string, not the direct
# db.<ref>.supabase.co one. Supabase's direct host is IPv6-only on
# projects created since early 2024 and Render's egress is IPv4, so a
# direct string just times out on connect.
#
# Supabase dashboard > Project Settings > Database > Connection string >
# choose "Session pooler". It looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# The Transaction pooler (port 6543) also works - nothing in this app
# depends on session state - but session mode is the simpler default.

# Optional: connection pool ceiling. Default 10, which is plenty here and
# leaves room in Supabase's shared connection budget for the dashboard
# and any open SQL console.
# PG_POOL_MAX=10

# --- Core -----------------------------------------------------------
SESSION_SECRET=change-me
NODE_ENV=development
PORT=4000

# Everything below is optional locally - each feature degrades to
# "not configured" rather than erroring when its key is missing.
# FRONTEND_URL=http://localhost:5173
# CRON_SECRET=
# SIGNUP_CODE=
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=Starlink Monitor
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Nominatim's usage policy asks for a contact address in the User-Agent.
# NOMINATIM_CONTACT_EMAIL=you@example.com
